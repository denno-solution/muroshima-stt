# OpenAI
OPENAI_API_KEY=your-openai-api-key

# ElevenLabs
ELEVENLABS_API_KEY=your-elevenlabs-api-key
# 既定の言語コード（未指定時に適用）。例: ja / en / zh など
ELEVENLABS_LANGUAGE_CODE=ja
# 使用するSTTモデルID
ELEVENLABS_MODEL_ID=scribe_v2
# 非音声イベントのタグ付け（laughter, applause など）を含めるか
ELEVENLABS_TAG_AUDIO_EVENTS=false

# Google Generative AI (Gemini)
GEMINI_API_KEY=your-gemini-api-key

# Google Cloud Speech-to-Text
GOOGLE_CLOUD_PROJECT=your-google-cloud-project-id
GOOGLE_CLOUD_LOCATION=us

# Database
DATABASE_URL=sqlite:///./audio_transcriptions.db
# Turso(libSQL) の例
# DATABASE_URL=sqlite+libsql://your-db-your-org.turso.io?secure=true&authToken=your-turso-token

# 社長音声（本番では DATABASE_URL 必須）
# CEO_VAD_OUTPUT_DIR=/path/to/vad-output
# CEO_VAD_MAX_BYTES=52428800
# CEO_VAD_MAX_DURATION_SECONDS=900
# CEO_DURATION_DECODE_MAX_BYTES=26214400

# RAG / Embeddings
# ENABLE_RAG=true
# EMBEDDING_MODEL=text-embedding-3-large   # 既定。dimensions=1536で格納（モデル変更時は全件再インデックスが自動で促される）
# EMBEDDING_DIM=1536                        # 埋め込みの格納次元（変更時はDB再作成が必要）
# RAG_COMPLETION_MODEL=gpt-5.6-luna        # Responses API対応の推奨既定
# RAG_RETRIEVAL_K=100              # 検索候補として取得するチャンク上位件数
# コンテキストは録音単位で組み立てる（チャンク断片ではなく全文/周辺結合を渡す）
# RAG_CONTEXT_MAX_DOCS=6           # 通常検索で読み込む録音の最大数
# RAG_AGGREGATE_MAX_DOCS=30        # 期間ブラウズ・「まとめて」系で読み込む録音の最大数
# RAG_CONTEXT_MAX_CHARS=40000      # コンテキスト総文字数の上限
# RAG_WHOLE_DOC_THRESHOLD=4000     # この文字数以下の録音は全文を渡す
# ハイブリッド検索（キーワード×ベクトル、重み付きRRFで融合）
# RAG_HYBRID_ALPHA=0.4           # 1.0=ベクトルのみ / 0.0=キーワードのみ（実データ評価で0.4が最良）

# （Supabase Storage 連携は廃止しました）

# Basic認証（オプション）
BASIC_AUTH_USERNAME=admin
BASIC_AUTH_PASSWORD=your-secure-password

# === Microphone recording: local & Cloudflare R2 ===
# ローカル保存（既定: 有効）
SAVE_MIC_AUDIO_LOCAL=false
# 保存先ディレクトリ（相対パス可）
MIC_AUDIO_SAVE_DIR=data/recordings

# R2 にも保存（既定: 無効）
SAVE_MIC_AUDIO_TO_R2=false
# R2 設定（S3互換APIを使用）
# 参考: https://developers.cloudflare.com/r2/
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# オブジェクトのキー接頭辞（任意、例: recordings/）
R2_PREFIX=recordings/
# 公開URLのベース（任意。例: https://pub-xxxxxx.r2.dev/my-bucket または https://media.example.com）
R2_PUBLIC_BASE_URL=
# 署名付きURLの有効期限（秒, 任意。既定: 900=15分）
R2_SIGNED_URL_EXPIRES=900
